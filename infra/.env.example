# Settings for docker-compose.prod.yml. On the server: cp infra/.env.example infra/.env, fill it in,
# chmod 600 infra/.env. Never commit infra/.env (git-ignored). Random values: openssl rand -base64 32
# (for passwords: openssl rand -hex 24, no characters a URL or shell would mangle).
# Docker Compose reads infra/.env for the local file too: locally, a value left empty keeps its
# development default, and the production-only ones are ignored.

# image tag published by CI (a git SHA, or latest)
RYDEX_TAG=latest

# the public name Caddy serves and gets a Let's Encrypt certificate for
SITE_ADDRESS=rydex.duckdns.org
# browsers allowed to call the API: the Vercel app and this server (which serves the web app too)
CORS_ALLOWED_ORIGINS=https://rydex.vercel.app,https://rydex.duckdns.org

# Postgres: the superuser and one role per service (ADR 0004)
POSTGRES_PASSWORD=
RIDE_DB_PASSWORD=
DRIVER_DB_PASSWORD=
TRACKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
AI_DB_PASSWORD=

# ride-service secrets (RYDEX_STRICT_SECRETS refuses the development defaults)
OTP_SECRET=
# 32 random bytes each, base64 (openssl rand -base64 32); never change them once accounts exist
PII_DATA_KEY=
PII_INDEX_KEY=

# payments: mock (charges succeed at once) or razorpay (test keys only: rzp_test_...)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
