# Copy to .env.local to override. Leave both empty locally: the Vite dev server proxies
# /api and /ws to the services (vite.config.ts).
# Production (Vercel): the backend's public origin, e.g. https://rydex.duckdns.org
VITE_API_URL=
# Production: wss://rydex.duckdns.org/ws (defaults to the API origin's /ws)
VITE_WS_URL=
# Show the "Simulate driving" switch on the driver screen (always on in dev builds)
VITE_ENABLE_SIMULATOR=false
