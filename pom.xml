<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.rydex</groupId>
    <artifactId>rydex-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Rydex</name>
    <description>Uber-style ride hailing with real-time tracking and AI ride suggestions</description>
    <url>https://github.com/Boovesh985/rydex</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Boovesh985</id>
            <name>T BOOVESHWARAN</name>
            <url>https://github.com/Boovesh985</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Boovesh985/rydex</url>
        <connection>scm:git:https://github.com/Boovesh985/rydex.git</connection>
        <developerConnection>scm:git:git@github.com:Boovesh985/rydex.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Boovesh985/rydex/issues</url>
    </issueManagement>

    <modules>
        <module>libs/common-events</module>
        <module>libs/messaging</module>
        <module>libs/presence</module>
        <module>services/ride-service</module>
        <module>services/driver-service</module>
        <module>services/tracking-service</module>
        <module>services/payment-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>3.1.1</springdoc.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- JaCoCo's prepare-agent fills this in; empty default keeps @{argLine} valid when it is skipped. -->
        <argLine></argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.rydex</groupId>
                <artifactId>common-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydex</groupId>
                <artifactId>messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydex</groupId>
                <artifactId>presence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- NIO pipes on Windows use Unix-domain sockets in %TEMP%; a user profile path with
                             spaces/8.3 names makes Tomcat fail with "Unable to establish loopback connection". -->
                        <!-- Mockito's inline mock maker is loaded as an agent up front (resolved by the
                             dependency plugin's "properties" goal) instead of self-attaching at run time,
                             which JDK 21 warns about and which fails intermittently on Windows. -->
                        <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Djdk.net.unixdomain.tmpdir=${project.build.directory}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- same Windows loopback-socket workaround for `mvnw spring-boot:run`; and a small
                             footprint, so four services, Docker and a browser fit an 8 GB laptop (local runs
                             only: tests and images set their own) -->
                        <jvmArguments>-Djdk.net.unixdomain.tmpdir=${project.build.directory} -Xms64m -Xmx320m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=64m -XX:MaxMetaspaceSize=192m</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- exposes ${group:artifact:jar} paths of dependencies, for the Mockito agent above -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
