{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rydex.dev/contracts/events/event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Wire format of every Kafka message in Rydex. Mirrors com.rydex.events.EventEnvelope.",
  "type": "object",
  "required": ["eventId", "eventType", "version", "occurredAt", "rideId", "payload"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "enum": [
        "RIDE_REQUESTED", "DRIVER_ASSIGNED", "NO_DRIVER_FOUND", "DRIVER_ARRIVED",
        "RIDE_STARTED", "RIDE_COMPLETED", "RIDE_CANCELLED",
        "PAYMENT_INITIATED", "PAYMENT_SUCCEEDED", "PAYMENT_FAILED", "PAYMENT_REFUNDED"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "rideId": { "type": "string", "minLength": 1 },
    "payload": { "type": ["object", "null"] }
  }
}
